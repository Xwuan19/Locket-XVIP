#!name = Locket-XVIP (Super VIP Pro Max)
#!desc = Kích hoạt Locket Gold trọn đời (RevenueCat) + 4K Ultra HD + 30s Video + Vô hạn bạn bè + Ai đã xem + Khôi phục Streak + Chặn QC (Firebase). By Xwuan
#!author = Xwuan
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Locket.png

[Script]
# RevenueCat
http-request ^https:\/\/api\.revenuecat\.com\/.*\/(receipts|subscribers) script-path=https://raw.githubusercontent.com/Xwuan19/Locket-XVIP/main/js/locket_revenuecat_request.js, timeout=120, tag=Locket_RC_Request
http-response ^https:\/\/api\.revenuecat\.com\/.*\/(receipts$|subscribers\/[^/]+$) script-path=https://raw.githubusercontent.com/Xwuan19/Locket-XVIP/main/js/locket_revenuecat_response.js, requires-body=true, timeout=120, tag=Locket_RC_Response

# Firebase
http-request ^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/namespaces\/firebase:fetch script-path=https://raw.githubusercontent.com/Xwuan19/Locket-XVIP/main/js/locket_firebase_request.js, requires-body=true, timeout=60, tag=Locket_Firebase_Request
http-response ^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/namespaces\/firebase:fetch script-path=https://raw.githubusercontent.com/Xwuan19/Locket-XVIP/main/js/locket_firebase_response.js, requires-body=true, timeout=60, tag=Locket_Firebase_Response

[Mitm]
hostname = api.revenuecat.com, firebaseremoteconfig.googleapis.com
