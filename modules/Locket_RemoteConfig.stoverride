name: Locket-XVIP Remote Config
desc: Kích hoạt Full Locket Gold, Ultra HD 4K, vô hạn bạn bè, mở khóa tất cả tính năng VIP & chặn quảng cáo.

http:
  mitm:
    - "firebaseremoteconfig.googleapis.com"
  script:
    - match: ^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/namespaces\/firebase:fetch
      name: locket_firebase_request
      type: request
      require-body: true
      max-size: -1
      script-path: https://raw.githubusercontent.com/Xwuan19/Locket-XVIP/main/js/locket_firebase_request.js
    - match: ^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/namespaces\/firebase:fetch
      name: locket_firebase_response
      type: response
      require-body: true
      max-size: -1
      script-path: https://raw.githubusercontent.com/Xwuan19/Locket-XVIP/main/js/locket_firebase_response.js
